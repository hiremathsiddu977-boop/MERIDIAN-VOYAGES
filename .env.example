# DATABASE_URL: PostgreSQL connection string (Vercel Postgres, Neon, Supabase, or Railway).
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/meridian_voyages?sslmode=require"

# SESSION_SECRET: Secret used to sign 7-day customer and owner session tokens.
SESSION_SECRET="replace-with-a-random-32-char-secret"

# GEMINI_API_KEY: Optional API key for AI Travel Concierge & Executive Advisor replies.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted.
APP_URL="MY_APP_URL"
